{
  "name": "6ix-buyer-os",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:db": "supabase test db",
    "test:e2e": "playwright test",
    "test:live": "vitest run --project live",
    "test:all": "pnpm test && pnpm test:db && pnpm test:integration && pnpm test:e2e",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > lib/db/types.ts",
    "admin:bootstrap": "node --env-file=.env.local scripts/invite-bootstrap-admin.mts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "@base-ui/react": "^1.9.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.75.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.23.0",
    "supabase": "^3.2.0",
    "tailwindcss": "4.3.5",
    "typescript": "^6",
    "vitest": "^5.1.1"
  },
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24"
  }
