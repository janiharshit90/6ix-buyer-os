# Copy to .env.local and fill in. Never commit real values.
# Hosted project: Supabase Dashboard → Project Settings → API Keys.
# Local stack: `pnpm db:start`, then `pnpm exec supabase status` prints the local values.

# --- App (browser-safe) ---
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...) or the legacy anon key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# e.g. http://localhost:3000 locally
NEXT_PUBLIC_SITE_URL=

# --- Server only: never prefix with NEXT_PUBLIC_ ---
# Secret key (sb_secret_...) or the legacy service_role key. Bypasses RLS.
SUPABASE_SECRET_KEY=
# First admin: when this exact email signs in and no active admin exists, it becomes admin.
BOOTSTRAP_ADMIN_EMAIL=

# --- AI (server only) ---
# Anthropic API key. Unset = AI features show "AI is not configured"; the rest of the app works.
# Use a separate key per environment and set a spend limit on it in the Anthropic Console.
ANTHROPIC_API_KEY=
# Optional model overrides per tier (defaults live in lib/ai/config.ts).
AI_MODEL_GENERATION=
AI_MODEL_CLASSIFICATION=
# Dev/test only: 1 = canned in-process model, no API calls. Refused in production.
AI_FAKE=
# --- Background jobs (server only) ---
# Direct Postgres URL for jobs that act as the user. TOP-TIER SECRET: never log or share it.
# Local: the DB_URL from `pnpm exec supabase status`. Vercel: the Supabase transaction-pooler URL (port 6543).
DATABASE_URL=
# Local dev: 1 = use the Inngest dev server (`pnpm inngest:dev`). Never set on Vercel.
INNGEST_DEV=
# Vercel: set by the Inngest integration. Leave empty locally.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Test-only (e2e): map .test hosts to a local fixture server. Refused on Vercel. Never set it there.
FETCHER_TEST_HOSTS=

# Opt-in live smoke test (`pnpm test:live`): 1 = make real (billed) API calls.
AI_LIVE_TESTS=

# --- Supabase CLI only (supabase link / db push); set in your shell, not here ---
# SUPABASE_ACCESS_TOKEN=
# SUPABASE_DB_PASSWORD=
